DJANGO_ENV=development
# Generate a secret before deployment; never commit the real .env.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# SQLite locally. Set DB_ENGINE=postgresql to use PostgreSQL.
DB_ENGINE=sqlite
DB_NAME=invoice_desk
DB_USER=invoice_desk
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Leave empty for local in-process cache and eager background tasks.
REDIS_URL=
CELERY_BROKER_URL=
# Password reset mail is printed in the backend terminal locally.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Invoice Desk <noreply@example.com>
TRUST_PROXY=false
