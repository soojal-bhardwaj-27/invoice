# Public HTTPS origin once you have deployed. No trailing path.
# SITE_URL=https://your-project.vercel.app
# Enable only on the Production environment when the site is ready.
PUBLIC_INDEXING=false
# Backend hosting is separate from the Vercel frontend.
BACKEND_URL=http://127.0.0.1:8000
# Optional Search Console verification token (not a private credential).
# GOOGLE_SITE_VERIFICATION=
